# Local Development Configuration for Android
# This file is NOT committed to Git (.gitignore)

# Enable local backend connection for mobile development
REACT_APP_FORCE_LOCAL_BACKEND=true

# For physical Android device via WiFi, use your computer's IP address:
# Your local IP: 10.172.36.26
REACT_APP_LOCAL_BACKEND_URL=http://10.172.36.26:10000/api

# For Android Emulator, use 10.0.2.2 instead:
# REACT_APP_LOCAL_BACKEND_URL=http://10.0.2.2:10000/api

# Note: After changing this file, you must rebuild the app:
# npm run build && npx cap sync android
