# =============================================================================
# Keystore Configuration Template for SINDH Android App
# =============================================================================
# 
# IMPORTANT: This is a template file. DO NOT put real passwords here!
# 
# To use this template:
# 1. Copy this file to `keystore.properties` (without .example extension)
# 2. Replace placeholder values with your actual keystore credentials
# 3. NEVER commit `keystore.properties` to version control (already in .gitignore)
# 
# =============================================================================
# KEYSTORE SETUP INSTRUCTIONS
# =============================================================================
# 
# If you don't have a keystore yet, generate one using this command:
# 
#   keytool -genkey -v -keystore android/release-keystore.jks \
#     -keyalg RSA -keysize 2048 -validity 10000 \
#     -alias sindh-jobs-key
# 
# You'll be prompted to enter:
# - Keystore password (use a strong password!)
# - Key password (can be same as keystore password)
# - Your name, organization, city, state, country
# 
# CRITICAL: Back up your keystore file and passwords securely!
# If you lose the keystore, you CANNOT update your app on Google Play Store.
# 
# =============================================================================
# CONFIGURATION PROPERTIES
# =============================================================================

# Path to your release keystore file (relative to android/ directory)
# Default: release-keystore.jks (place it in android/ directory)
storeFile=release-keystore.jks

# Password for the keystore file
# NEVER commit the actual password - keep it in a password manager!
storePassword=YOUR_STORE_PASSWORD_HERE

# Alias name you used when generating the keystore
# This identifies which key in the keystore to use for signing
keyAlias=sindh-jobs-key

# Password for the specific key (can be same as storePassword)
keyPassword=YOUR_KEY_PASSWORD_HERE

# =============================================================================
# SECURITY BEST PRACTICES
# =============================================================================
# 
# 1. NEVER commit keystore.properties to version control
#    ✅ It's already in .gitignore, but double-check before commits
# 
# 2. Store keystore file (release-keystore.jks) in a secure location
#    ✅ Back it up to encrypted cloud storage
#    ✅ Keep an offline backup on encrypted USB drive
# 
# 3. Use strong passwords (minimum 12 characters, mixed case, numbers, symbols)
# 
# 4. Document keystore location and credentials in your team's password manager
#    (1Password, LastPass, Bitwarden, etc.)
# 
# 5. For CI/CD pipelines, use environment variables instead:
#    - SINDH_KEYSTORE_FILE=/path/to/keystore.jks
#    - SINDH_KEYSTORE_PASSWORD=your_store_password
#    - SINDH_KEY_ALIAS=sindh-jobs-key
#    - SINDH_KEY_PASSWORD=your_key_password
# 
# =============================================================================
# CI/CD CONFIGURATION (GitHub Actions, Jenkins, etc.)
# =============================================================================
# 
# Instead of using keystore.properties in CI/CD, set these environment variables:
# 
# export SINDH_KEYSTORE_FILE="/path/to/release-keystore.jks"
# export SINDH_KEYSTORE_PASSWORD="your_store_password"
# export SINDH_KEY_ALIAS="sindh-jobs-key"
# export SINDH_KEY_PASSWORD="your_key_password"
# 
# The build.gradle is configured to automatically use environment variables
# when keystore.properties doesn't exist (typical in CI/CD environments).
# 
# For GitHub Actions, store keystore as base64 secret:
# 1. Base64 encode: base64 -i release-keystore.jks -o keystore.base64
# 2. Add to GitHub Secrets as KEYSTORE_FILE (paste base64 content)
# 3. Add passwords as secrets: KEYSTORE_PASSWORD, KEY_ALIAS, KEY_PASSWORD
# 4. In workflow, decode keystore:
#    echo "${{ secrets.KEYSTORE_FILE }}" | base64 -d > release-keystore.jks
# 
# =============================================================================
# VERIFICATION
# =============================================================================
# 
# After setting up keystore.properties, verify your configuration:
# 
# Windows PowerShell:
#   cd android
#   .\gradlew assembleRelease
# 
# Linux/macOS:
#   cd android
#   ./gradlew assembleRelease
# 
# If successful, signed APK will be in:
#   android/app/build/outputs/apk/release/app-release.apk
# 
# Verify the APK is signed:
#   keytool -printcert -jarfile app/build/outputs/apk/release/app-release.apk
# 
# You should see your keystore details (CN, OU, O, etc.)
# 
# =============================================================================
